# Copy to .env and fill in. Never commit the real .env file.
# Every value below has a safe default in app/core/config.py — the system runs fully
# autonomously (via the simulator gateway + ML-only scoring) with NO values set at all.

# --- Application ---
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO
# Comma-separated allowed origins for cross-origin API calls (needed once the frontend is
# deployed separately from the backend, e.g. on Render — see docs/deployment.md). "*" is fine
# for local dev and a single-tenant demo with no cookie-based auth.
CORS_ALLOWED_ORIGINS=*

# --- Database ---
# Local docker-compose default. Async driver (asyncpg) is required.
DATABASE_URL=postgresql+asyncpg://recoveryos:recoveryos@localhost:5432/recoveryos

# --- Razorpay (Test Mode only — never put live keys here) ---
# https://dashboard.razorpay.com/app/keys (toggle to Test Mode first)
# Leave KEY_ID/KEY_SECRET empty to run entirely on the simulator gateway
# (app/integrations/gateway_factory.py) — no real Razorpay call is ever made without both set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks > create a webhook, copy its secret here for REAL Razorpay test-mode
# traffic. The default below is NOT a real Razorpay secret — it's a local-dev value the
# simulator signs its own generated events with, so the demo works with zero configuration
# while still exercising the real signature-verification code path. See
# docs/razorpay-integration.md §8 and docs/decisions.md ADR-004.
RAZORPAY_WEBHOOK_SECRET=recoveryos-local-dev-webhook-secret

# --- AI / LLM ---
# Provider is abstracted behind app/agents/ai_diagnostician.py (real Anthropic integration,
# see docs/ai-design.md). Leave LLM_API_KEY empty to run without AI diagnosis — the pipeline
# falls back to the ML score alone (docs/reliability.md's "if LLM fails" rule).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=

# --- Revenue Signal Engine ---
MIN_AMOUNT_AT_RISK_PAISE=100     # ₹1 — excludes trivial/test amounts

# --- Recovery policy thresholds (see docs/decisions.md ADR-006 for how these were derived) ---
MIN_RECOVERY_PROBABILITY=0.15
MIN_EXPECTED_VALUE=0.05          # fraction of payment amount, e.g. 0.05 = 5%
MIN_CONFIDENCE=0.15              # calibrated against the trained model's actual output range
MAX_RETRIES=3
RECOVERY_WINDOW_HOURS=168        # 7 days

# --- Placeholder intervention cost model (paise) — see docs/decisions.md ADR-006 ---
DEFAULT_INTERVENTION_COST_PAISE=20
HINGLISH_VOICE_INTERVENTION_COST_PAISE=500
HINGLISH_VOICE_RISK_COST_PAISE=100
NOTIFICATION_RISK_COST_PAISE=10
